# words MCP Server の設定例。
# このファイルをコピーして .env を作る。.env は .gitignore で除外されており、
# GitHub へは決して入らない。本番では各ホスティングの「秘密」機能に入れること。

# 【秘密】管理キー。wordsの設定画面からサーバーを操作するときに使う。
# 32文字以上のランダムな文字列にする。作り方の例:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WORDS_OWNER_KEY=

# 【公開可】words本体（静的サイト）の場所。教材データの読み込み元とCORSの許可先になる。
WORDS_SITE_ORIGIN=https://hsgwyuki0429-design.github.io/words

# 【公開可・任意】教材データだけ別の場所から読むときに指定する。
# WORDS_DATA_BASE_URL=https://hsgwyuki0429-design.github.io/words

# 【公開可・任意】MCP Server自身の公開URL。
# 前段にプロキシがあり、外から見えるURLが内部と違うときだけ指定する。
# WORDS_PUBLIC_URL=https://words-mcp.example.workers.dev

# 【公開可・任意】CORSを許可する追加の場所（カンマ区切り）。
# WORDS_ALLOWED_ORIGINS=http://localhost:4173

# 【公開可・任意】Nodeで動かすときの保存先ディレクトリ。
# WORDS_DATA_DIR=.words-data
